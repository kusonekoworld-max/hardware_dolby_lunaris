// Dolby Atmos DAX3 3.6.0.12 (blob dari modul Fix_Dolby_Ksu_Lunaris yg terbukti jalan di creek)
soong_namespace {
}

cc_prebuilt_library_shared {
    name: "libdapparamstorage",
    owner: "xiaomi",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["proprietary/vendor/lib64/libdapparamstorage.so"],
            shared_libs: ["libcutils", "libutils", "liblog"],
        },
    },
    compile_multilib: "64",
    prefer: true,
    soc_specific: true,
}

