# daxService (priv-app) & app Dolby perlu menemukan dan memanggil DMS HAL (sesuai sepolicy.rule modul)
allow priv_app hal_dms_hwservice:hwservice_manager find;
binder_call(priv_app, hal_dms_default)

# Dolby apps read audio props and stat the DMS service (per the module's sepolicy.rule)
get_prop(priv_app, vendor_audio_prop)
allow priv_app hal_dms_default_exec:file getattr;
